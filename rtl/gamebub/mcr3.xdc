## ============================================================================
## mcr3.xdc: the core's own constraints (the framework build picks up every
## .xdc under rtl/). Cell paths are matched loosely (*/memory/sram/...) because the
## framework's wrapper hierarchy names are generated by Chisel. After
## MacLC_GameBub's maclc.xdc.
## ============================================================================

## ---- SRAM (IS61WV25616, 10 ns): sound and sprite ROMs -------------------------------
## gb_sram drives every pin from a register and captures read data one
## full clk_sys period (25 ns) after the address leaves; tAA is 10 ns, so
## the budget is comfortable. Pack the registers into the I/O blocks so that
## placement cannot change it. (sram_dq_oe drives 16 pins' tristates and
## stays in the fabric.)
set_property IOB TRUE [get_cells -quiet -hier -filter {NAME =~ */memory/sram/sram_a_reg*}]
set_property IOB TRUE [get_cells -quiet -hier -filter {NAME =~ */memory/sram/sram_we_n_reg*}]
set_property IOB TRUE [get_cells -quiet -hier -filter {NAME =~ */memory/sram/sram_oe_n_reg*}]
set_property IOB TRUE [get_cells -quiet -hier -filter {NAME =~ */memory/sram/sram_ce_n_reg*}]
set_property IOB TRUE [get_cells -quiet -hier -filter {NAME =~ */memory/sram/sram_mask_n_reg*}]
set_property IOB TRUE [get_cells -quiet -hier -filter {NAME =~ */memory/sram/sram_dq_out_reg*}]
set_property IOB TRUE [get_cells -quiet -hier -filter {NAME =~ */memory/sram/q_reg*}]
